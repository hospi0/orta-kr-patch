 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 0,
  "budget": 41,
  "jp": "\n少女は、暗い牢でずっと鎖につながれていた",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 1,
  "budget": 47,
  "jp": "\n幼い頃から…　世界も、　自分自身も知らぬまま…",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 2,
  "budget": 43,
  "jp": "\n\"伝聞\"は…　うまく伝わらなかったのだろうか",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 3,
  "budget": 35,
  "jp": "\nエヴレーン隊長！　娘を見つけました",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 4,
  "budget": 13,
  "jp": "\n全騎、続け！",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 5,
  "budget": 5,
  "jp": "\n了解",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 6,
  "budget": 7,
  "jp": "\n了解！",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 7,
  "budget": 27,
  "jp": "\n夜が明けたら畑に麦を播こう",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 8,
  "budget": 21,
  "jp": "\n日差しが土を焼く前に",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 9,
  "budget": 27,
  "jp": "\n雨がやんだら畑に麦を播こう",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 10,
  "budget": 27,
  "jp": "\n水銀の霧が私の喉を焼く前に",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 11,
  "budget": 25,
  "jp": "\n亜麻の布を織り　羊を追い",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 12,
  "budget": 29,
  "jp": "\nぶどう棚の陰にある小さな家で",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 13,
  "budget": 25,
  "jp": "\nここにはもういない貴方と",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 14,
  "budget": 27,
  "jp": "\n同じ歌口ずさみ生きていこう",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 15,
  "budget": 27,
  "jp": "\n夜が明けたら畑に麦を播こう",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 16,
  "budget": 21,
  "jp": "\n風が土を凍らせる前に",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 17,
  "budget": 27,
  "jp": "\n雨がやんだら畑に麦を播こう",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 18,
  "budget": 29,
  "jp": "\n涙の塩が私の目を凍らせる前に",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 19,
  "budget": 16,
  "jp": "エッジ、どうだ？",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 20,
  "budget": 20,
  "jp": "何もない、異常なしだ",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 21,
  "budget": 22,
  "jp": "こんなものか、実戦って",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 22,
  "budget": 20,
  "jp": "気楽でいいな、子供は",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 23,
  "budget": 22,
  "jp": "ルーアは知ってるのか？",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 24,
  "budget": 28,
  "jp": "僕らがここで何を守ってるのか",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 25,
  "budget": 10,
  "jp": "どうして？",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 26,
  "budget": 18,
  "jp": "知りたくないのか？",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 27,
  "budget": 10,
  "jp": "ごめんだね",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 28,
  "budget": 36,
  "jp": "経験から言うと、帝国に首を突っ込むと",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 29,
  "budget": 16,
  "jp": "ろくなことがない",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 30,
  "budget": 30,
  "jp": "今だってろくなことなんてないさ",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 31,
  "budget": 32,
  "jp": "いいか、よけいなことに関わるなよ",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 32,
  "budget": 18,
  "jp": "それが俺達の鉄則だ",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 33,
  "budget": 22,
  "jp": "俺達は帝国軍に雇われて",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 34,
  "budget": 20,
  "jp": "この発掘所を守ってる",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 35,
  "budget": 10,
  "jp": "それだけだ",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 36,
  "budget": 22,
  "jp": "必要以上の詮索は無用、",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\Text_Movie_JP.msg",
  "idx": 37,
  "budget": 18,
  "jp": "死にたくないならな",
  "ko": null
 }
]