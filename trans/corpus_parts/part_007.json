 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 160,
  "budget": 16,
  "jp": "ドラゴンメア幼体",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 161,
  "budget": 6,
  "jp": "その他",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 162,
  "budget": 165,
  "jp": "$c0＜戦闘空艇ブート＞\n　回転式砲台を装備した一人乗りの\n飛空艇。\n　高い機動力と量産性を持った帝国軍\nの主力航空機である。\n　局地戦闘や迎撃など、様々な用途に\n対応する。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 163,
  "budget": 204,
  "jp": "$c0＜駆逐砲車ダラ＞\n　降着用の伸縮脚を四本持った装甲\n浮遊車両。\n　重い機体を持ち上げる浮遊機関を\n腹部に持ち、航空機顔負けの速度で\n移動することができる。\n　歩兵部隊の輸送から拠点制圧まで\n汎用的に使われる。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 164,
  "budget": 231,
  "jp": "$c0＜ブート改＞\n　採取した研究材料を輸送している\n飛空艇。\n　戦場は攻守の場であると同時に、\n兵器開発の最前線でもある。\n　征圧した攻性生物の標本や、\n実験兵器の威力を示す被験体などを\n収集し、アカデミーに持ち帰るのが、\nこの機体の役割。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 165,
  "budget": 234,
  "jp": "$c0＜ドラゴンメア＞\n　帝国によって生み出されたドラゴン型\n攻性ユニット。\n　頑丈な装甲に覆われた肉体は自己\n修復機能を持ち、大きく裂けた口から\n吐く超高温の粘着爆燃弾、長い尾に\nよる攻撃など、各性能は通常帝国兵器\nのレベルをはるかに超える。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 166,
  "budget": 240,
  "jp": "$c0＜強襲空母ヴァーマナ＞\n　攻性化部隊の中核となる新造輸送艦。\n　帝国きっての最新鋭装備とエリート\n乗務員を備えている。\n　主戦力であるドラゴンメア以外にも、\n側面の迎撃砲台や艦首二門の雷撃砲\nなど、単独で戦艦レベルと渡り合うだけ\nの火力を誇る。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 167,
  "budget": 259,
  "jp": "$c0＜誘導爆雷＞\n　四連噴進機構つきの強力な誘導弾。\n装甲化要塞の制圧を目的に開発され、\n　たいへんな量の炸薬が詰め込まれて\nいる。\n　直撃なら帝国巡洋艦級でも一撃で\n沈めることができるだろう。\n　空中爆発で広範囲に甚大な被害を\n与えるため対空兵器としても用いられる。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 168,
  "budget": 290,
  "jp": "$c0＜帝国兵＞\n　強襲空母艦内で勤務する帝国兵士。\n選民主義を貫く将校クラスとは異なり、\n歩兵や艦上勤務兵のほとんどは\n帝国勢力圏内の雑多な民族から構成\nされている。\n　その多くは志願兵で、自費で装備を\n揃え過酷な任務に殉じている。軍人に\n最上の名誉と地位をあたえる帝国の\n啓蒙活動の成果といえよう。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 169,
  "budget": 185,
  "jp": "$c0＜戦闘機カーマ＞\n　対空迎撃を目的として帝国艦隊に\n装備されている飛空艇。\n　長大な信号旗を飛空艇間の通信に\n使用している。\n　機体を折り畳み格納することで、大量の\n搭載を可能としている。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 170,
  "budget": 241,
  "jp": "$c0＜駆逐艦タイシャーク＞\n　帝国機甲艦隊の主力艦。後部ハッチ\nに迎撃機を6機搭載している。\n　海洋小型船舶戦を得意としていた\n南方民族の「数の優位」と\n「連携の威力」という戦闘教義を反映し、\n集団運用と囲い込みによる迎撃を目指し\nて設計されている。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 171,
  "budget": 242,
  "jp": "$c0＜誘導艇アヤチ・トプ＞\n　大出力の牽引機能を持つ戦闘艦。\n元々は、自力航行できなくなった味方\n艦艇を回収するために開発された。\n　それを転用して大型攻性生物の捕獲\nに用いるべく再設計されたが、機動性の\n低さがたたって活躍の場を与えられて\nいない。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 172,
  "budget": 243,
  "jp": "$c0＜対攻性艦シャイハ＞\n　大型の反射板を前面に備えた中型\n突撃艦。\n　反射板は対光学処理がされており、\n旧世紀系の光学攻撃のほとんどを反射\nすることができる。\n　旋回が緩慢なのがやや難点だが、\n陣形を組んでの大型攻性生物征圧に\n絶大な威力を発揮する。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 173,
  "budget": 139,
  "jp": "$c0＜艦載砲台＞\n　基本的な仕様は機甲艦に装備されて\nいる砲とあまり変わらないが、皇族の\n行幸時に祝砲を撃つ砲台として用いら\nれる由緒ある砲台。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 174,
  "budget": 207,
  "jp": "$c0＜艦載噴進砲台＞\n　連続装填・連続発射が可能な先進\n機構をもつ小型噴進砲台。\n　帝国軍内で、原理的に唯一実現され\nているものだが、機構的信頼性が低い\nため前線の将兵にはこれを歓迎しない\nものも一部見うけられる。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 175,
  "budget": 241,
  "jp": "$c0＜小型噴進弾＞\n　皇族艦の小型噴進砲台用の専用弾。\n旧来の誘導弾よりも高速・正確な\n自律弾道調整が可能だが、炸薬は\n少なく破壊力は劣る。\n　現在、より高破壊力の新型炸薬を\n開発中。\n　熱心な皇子派により開発され、側面に\n皇子の顔が刻印されている。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 176,
  "budget": 232,
  "jp": "$c0＜カーマ試験機＞\n　旧世紀エンジンを遺伝基技術によって\n強化した試験機体。\n　帝国アカデミーを主体とする攻性化\n部隊開発計画の途中で生み出された\nエンジン強化技術だが、耐久性が\nやや高いという以外に、特に秀でている\n点は見受けられない。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 177,
  "budget": 366,
  "jp": "$c0＜浮遊機雷兵マルダイ＞\n　みずからを擲弾（てきだん）とする\n機雷兵。浮遊樽を操作し、攻撃対象に\n接近して長い杖の先についた爆雷ごと\n体当たりする。\n　考案当時は皇帝臣民の命を無駄に\nすると非難を受けたが、噴進弾や誘導\n爆雷よりも優秀な迎撃成績を上げた\nため一躍有効な戦闘手段となった。\n　皇帝一族のためなら命をも投げ出す\n熱心な兵士、敵対国の奴隷兵によって\n組織されている。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 178,
  "budget": 170,
  "jp": "$c0＜皇衛仕様ダラ＞\n　駆逐放車ダラを皇族艦搭載用として\n装飾したもの。\n　戦闘力には変化がないが、希少な\n銅板をより多く使い、皇族のほまれを\nよくあらわした機体となっている。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 179,
  "budget": 178,
  "jp": "$c0＜皇衛兵＞\n　皇室直属の皇衛兵たち。\n　皇族艦に搭乗している人員の多くは\n航行・戦闘に無関係な非戦闘員だが、\n儀礼をはなばなしく盛り上げるためには\n欠かすことのできない人員である。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 180,
  "budget": 162,
  "jp": "$c0＜護人像＞\n　人類のために人神となった先代皇帝を\n称えるために搭載された戦闘像。\n　護人像の周囲で燃えつづける炎は、\n帝国によって人にもたらされた力の\n象徴である。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 181,
  "budget": 180,
  "jp": "$c0＜戦闘空艇ヴァラ＞\n　帝都上空および地下発掘所防衛の\nために配備された哨戒部隊の専用機。\n　発掘されたエンジンの中でも高性能\nかつ小型なものを搭載、重装甲と\n高機動の両立を実現した。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 182,
  "budget": 172,
  "jp": "$c0＜自走牽引車エムデン＞\n　旧式となった移動砲台を改修し、\n地下発掘所での物資輸送に運用されて\nいるもの。\n　砲台車両を追加装備として合体する\nことで防衛兵器として活用される。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 183,
  "budget": 182,
  "jp": "$c0＜哨戒機ヴァーユ＞\n　入り組んだ地形の警備や戦闘に\n向いた立体飛行戦闘艇。\n　発掘場やトンネル内で多く活躍する。\n　その機動性を活かし、各種情報の収集\n伝達や物資の輸送などもおこなう。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 184,
  "budget": 220,
  "jp": "$c0＜人工太陽＞\n　帝国地下発掘場に配備されている\n小型の人工太陽。\n　日光に比べると光量は極めて劣悪だが\n旧世紀エネルギーの活用により\nほぼ半永久的に光熱を得ることができる。\n　地下発掘場での作業に最も貢献した\n装備であろう。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 185,
  "budget": 200,
  "jp": "$c0＜小型起重艇＞\n　地下発掘場に配備されている帝国の\n起重機。\n　発掘品や各種装備を持ち上げ、輸送\nするのに使う。\n　これらの工作機械の多くは、帝国軍\n兵器の造船技術などからその基本技術\n設計を学んでいる。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 186,
  "budget": 164,
  "jp": "$c0＜移動吸引筒＞\n　帝国軍に配備されているポンプ車。\n　生活用水や空気を地上から導くほか、\n地下に発生する汚水をくみ出したり\n災害時の消火に使ったりと幅広く\n活躍する。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 187,
  "budget": 385,
  "jp": "$c0＜帝人機バキャルシュハ＞\n　帝国がその技術の粋を集めて建造した\n最終防衛兵器。\n　戦艦の頭脳たる艦橋と強大な火力を\n有した胴体艦を中心に、結線された\n右腕艦、左腕艦との連繋で敵を征圧\nする。\n　皇衛軍の先導により皇族と帝都の防衛\nを目的として建造された。\n　自然界においてもっとも優れた種である\n「人間」を目指した構造になっており、\n当初は二足歩行を予定していたが\n諸処の事情により断念された。",
  "ko": null
 },
 {
  "file": "menudata\\TextData\\text_pdb_db_empire_JP.msg",
  "idx": 188,
  "budget": 149,
  "jp": "$c0＜誘導砲弾＞\n　帝国の飛空艇が装備している誘導弾。\n　対地・対空と幅広い使い方ができる\n反面、装弾数が少ないため、使用対象\nの判断が非常に重要である。",
  "ko": null
 }
]