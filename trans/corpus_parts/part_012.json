 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 2,
  "budget": 10,
  "jp": "「あ―！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 3,
  "budget": 53,
  "jp": "教官「ポッドを操作して、\n　　指定地点に着地させろ！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 4,
  "budget": 79,
  "jp": "教官「Ａボタン、もしくは左トリガ＋右トリガで\n　　上昇する！　離せば落下する！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 5,
  "budget": 63,
  "jp": "教官「照準を上下に動かして\n　　常に進行方向を見るようにしろ！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 6,
  "budget": 34,
  "jp": "教官「だめだ、もっと速度を殺せ！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 7,
  "budget": 24,
  "jp": "教官「よし！　合格だ！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 8,
  "budget": 53,
  "jp": "教官「だめだ、着地地点が\n　　遠すぎる。　もう一度だ」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 9,
  "budget": 34,
  "jp": "教官「よし！　いい腕だ！　合格！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 10,
  "budget": 55,
  "jp": "教官「…残念ながら不合格だ。\n　　速やかに退出したまえ」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 11,
  "budget": 63,
  "jp": "教官「静かに着地させなければ、\n　　　ポッドが壊れてしまうぞ！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 12,
  "budget": 43,
  "jp": "教官「よーし、皇帝の\n　　肖像に着陸しろ！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 13,
  "budget": 24,
  "jp": "教官「後は体で覚えろ！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 14,
  "budget": 34,
  "jp": "「こんなとこ、抜けられるのかな…」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst1_JP.msg",
  "idx": 15,
  "budget": 20,
  "jp": "「慎重に、慎重に…」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst2_JP.msg",
