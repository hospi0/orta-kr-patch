  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst2_JP.msg",
  "idx": 3,
  "budget": 45,
  "jp": "教官「ポッドを操作し、\n　　攻性生物を倒せ！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst2_JP.msg",
