  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst2_JP.msg",
  "idx": 5,
  "budget": 27,
  "jp": "教官「Xなら連射が利くぞ！」",
  "ko": null
 },
 {
  "file": "messageevent\\MesData_sst2_JP.msg",
